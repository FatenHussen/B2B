{
    "name": "b2b/core",
    "description": "B2B Core — envelope, errors, money, idempotency, audit",
    "type": "library",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Modules\\Core\\CoreServiceProvider"]
        }
    },
    "minimum-stability": "dev"
}
