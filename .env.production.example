# Production — sentraxsy.com
# Copy to .env ON THE SERVER ONLY. Never commit the real .env.

APP_NAME="B2B Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dash.sentraxsy.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Damascus
APP_MAINTENANCE_DRIVER=file

# --- SPA cookie auth across subdomains (CLAUDE.md: shared subdomain) ---
# The leading dot is required so admin.* and dash.* share the session cookie.
SESSION_DOMAIN=.sentraxsy.com
SANCTUM_STATEFUL_DOMAINS=admin.sentraxsy.com
FRONTEND_URL=https://admin.sentraxsy.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Database (local MySQL 8 on the VPS) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=b2b_platform
DB_USERNAME=b2b_user
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=error

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sentraxsy.com"
MAIL_FROM_NAME="${APP_NAME}"

OTP_CHANNEL=log

# Comma-separated. Must be exact origins (no *) because cookies are used.
CORS_ALLOWED_ORIGINS=https://admin.sentraxsy.com
