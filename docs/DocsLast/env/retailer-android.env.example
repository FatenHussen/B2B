# تطبيق التاجر (Flutter) — انسخ للمتغيرات عندكم
# (flutter_dotenv / --dart-define). الباكند Laravel ما يقرأ هذا الملف.

# --- رابط الـ API (نفس الثلاث لوحات) ---
# محلي (محاكي Android: http://10.0.2.2:8000/api/v1)
API_BASE_URL=http://127.0.0.1:8000/api/v1
# API_BASE_URL=https://api.sentraxsy.com/api/v1

X_CLIENT=retailer-android
# X_CLIENT=retailer-ios

# --- دخول التاجر (OTP) ---
# هاتف البذرة: سوبر ماركت الأمانة
RETAILER_PHONE=+963931000001
# خارج production: ست أصفار عندما X-Client / client يبدأ بـ retailer-
OTP_DEV_CODE=000000
# أرسل النص "000000" (مو int). "0000" ما زال يُقبل خارج production.
# Production: رمز عشوائي 6 خانات (واتساب/SMS أو لوج الباكند).
# لا ترسل X-Idempotency-Key على request-otp / verify-otp / resend-otp.

# --- Firebase (من Firebase Console، مو من هذا الريبو) ---
# 1) Firebase Console → Project settings → Your apps
# 2) أضف Android (package) و iOS (bundle id)
# 3) نزّل وضَع في تطبيق Flutter:
#      android/app/google-services.json
#      ios/Runner/GoogleService-Info.plist
# 4) flutterfire configure → يولّد lib/firebase_options.dart
# الباكند لا يحتاج هذه المفاتيح في .env. بعد الدخول سجّل الرمز:
#   POST /api/v1/app/devices/push-token
#   { "token": "<FCM device token>", "platform": "android" }
#     أو "ios"
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
