# Testing environment.
#
# Without this file `php artisan --env=testing` falls back to .env and operates on
# b2b_platform — the development database. `migrate:fresh --seed --env=testing` then
# wipes local development data while doing nothing for the test suite, and
# `migrate:status --env=testing` reports on the wrong database entirely.
#
# The values below mirror the <env> block in phpunit.xml, which is what actually
# configures a Pest run. Keep the two in step: phpunit.xml wins during a test run,
# this file wins for artisan commands passed --env=testing.
#
# The suite still migrates the database itself through RefreshDatabase. This file makes
# artisan agree with it, not replace it.

APP_NAME="B2B Platform"
APP_ENV=testing
APP_KEY=base64:GdF2pksPviSomBo8UkuIERYsUft14VfO9mbOAWqCleI=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=4

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=b2b_platform_test
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
